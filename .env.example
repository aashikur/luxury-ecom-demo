# -------------------------------------------------------------
# LUXURY GARMENTS E-COM BOILERPLATE - ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------

# 1. MongoDB Connection String (Atlas or Local)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_URI=

# 2. Cloudinary Credentials (For image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 3. Base App URL (Used for API calls)
NEXT_PUBLIC_APP_URL=http://localhost:3000
